		font-family: var(--mono);
		font-size: 12px;
		color: var(--text);
	}

	pre {
		margin: 0;
		padding: 22px 20px;
		font-family: var(--mono);
		font-size: 14px;
		line-height: 1.75;
		color: var(--text-bright);
		overflow-x: auto;
		/* JetBrains Mono otherwise renders <- as an arrow and != as ≠ */
		font-variant-ligatures: none;
	}

	pre :global(.kw) {
		color: var(--code-keyword);
	}

	pre :global(.str) {
		color: var(--code-string);
	}

