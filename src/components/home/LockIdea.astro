<section class="lock-idea">
	<div class="wrap">
		<div class="cols">
			<div>
				<div class="eyebrow eb">The whole idea</div>
				<h2>One connection,<br />one lock</h2>
				<p>
					A TCP connection is one claim on one named lock. Closing the connection <em>is</em> the
					release — there is no release call to forget, and the next waiter in the FIFO queue is
					promoted at once.
				</p>
				<p>
					Promotion is a push, not a poll: the server sends <span class="acquired">ACQUIRED</span> on
					its own initiative, so handover latency is one one-way trip.
				</p>
				<a class="more" href="/concepts/how-it-works/">Read the mental model →</a>
			</div>

			<div>
				<div class="panel" id="lock-diagram">
					<div class="ld-head">
						<div class="ld-head-lock">
							<span class="eyebrow-sm">lock</span>
							<span class="ld-lock-name">nightly-import</span>
						</div>
						<div class="ld-head-token">
							<span class="eyebrow-sm">token</span>
							<span class="ld-token" data-token>41</span>
						</div>
					</div>

					<div class="ld-sessions" data-sessions>
						<div class="ld-row ld-holder">
							<span class="ld-tag">holder</span>
							<span class="ld-name">worker-a</span>
							<span class="ld-lease">lease 2s</span>
							<span class="ld-state">ACQUIRED</span>
						</div>
						<div class="ld-row ld-waiter">
							<span class="ld-pos">#1</span>
							<span class="ld-wname">worker-b</span>
							<span class="ld-wlease">lease 2s</span>
							<span class="ld-wstate">WAITING</span>
						</div>
						<div class="ld-row ld-waiter">
							<span class="ld-pos">#2</span>
							<span class="ld-wname">worker-c</span>
							<span class="ld-wlease">lease 5s</span>
							<span class="ld-wstate">WAITING</span>
						</div>
					</div>

					<div class="ld-controls">
						<button type="button" class="ld-btn-close" data-action="close">Close connection</button>
						<button type="button" class="ld-btn-hang" data-action="hang">Hang the holder</button>
						<button type="button" class="ld-btn-acquire" data-action="acquire">+ ACQUIRE</button>
					</div>
					<div class="ld-note" data-note aria-live="polite">
						A connection is a claim. Close it, hang it, or queue another claimant.
					</div>
				</div>

				<table class="handover">
					<thead>
						<tr>
							<th>Owner's exit</th>
							<th>Handover latency</th>
						</tr>
					</thead>
					<tbody>
						<tr>
							<td>Controlled stop (connection closed)</td>
							<td class="imm">immediate</td>
						</tr>
						<tr>
							<td>Force-released by an admin</td>
							<td class="imm">immediate</td>
						</tr>
						<tr>
							<td>Process killed, socket reset by the OS</td>
							<td class="imm">immediate</td>
						</tr>
						<tr>
							<td>Hang, GC pause, network partition</td>
							<td>≤ the owner's lease</td>
						</tr>
						<tr>
							<td>Slow reader/writer (stuck socket)</td>
							<td>≤ io-timeout per operation</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>
</section>

<script>
	const root = document.getElementById('lock-diagram');
	if (root) {
		const tokenEl = root.querySelector('[data-token]') as HTMLElement;
		const sessionsEl = root.querySelector('[data-sessions]') as HTMLElement;
		const noteEl = root.querySelector('[data-note]') as HTMLElement;

		type Session = { name: string; lease: string };
		let holder: Session | null = { name: 'worker-a', lease: '2s' };
		let queue: Session[] = [
			{ name: 'worker-b', lease: '2s' },
			{ name: 'worker-c', lease: '5s' },
		];
		let token = 41;
		let seq = 3;

		function render(note: string) {
			tokenEl.textContent = String(token);
			noteEl.textContent = note;
			let html = holder
				? `<div class="ld-row ld-holder">
						<span class="ld-tag">holder</span>
						<span class="ld-name">${holder.name}</span>
						<span class="ld-lease">lease ${holder.lease}</span>
						<span class="ld-state">ACQUIRED</span>
					</div>`
				: `<div class="ld-free">lock free — no session holds it</div>`;
			queue.forEach((w, i) => {
				html += `<div class="ld-row ld-waiter">
						<span class="ld-pos">#${i + 1}</span>
						<span class="ld-wname">${w.name}</span>
						<span class="ld-wlease">lease ${w.lease}</span>
						<span class="ld-wstate">WAITING</span>
					</div>`;
			});
			sessionsEl.innerHTML = html;
		}

		// Shift the head of the queue into holder; the token only advances
		// when a session was actually promoted — no grant, no new token.
		function promote(note: string) {
			const next = queue.shift() ?? null;
			holder = next;
			if (next) token += 1;
			render(note);
		}

		root.querySelector('[data-action="close"]')?.addEventListener('click', () => {
			if (!holder) return render('Nothing to close — the lock is free.');
			const old = holder.name;
			const next = queue[0];
			promote(
				next
					? `${old} closed its connection → ${next.name} promoted immediately, token +1. Close is the release.`
					: `${old} closed its connection → lock free, no waiters.`
			);
		});

		root.querySelector('[data-action="hang"]')?.addEventListener('click', () => {
			if (!holder) return render('Nothing to hang — the lock is free.');
			const { name: old, lease } = holder;
			const next = queue[0];
			promote(
				next
					? `${old} stopped answering → after ${lease} of silence the server promotes ${next.name} with a larger token.`
					: `${old} stopped answering → lock released after ${lease} of silence.`
			);
		});

		root.querySelector('[data-action="acquire"]')?.addEventListener('click', () => {
			const name = 'worker-' + String.fromCharCode(97 + (seq % 26));
			const lease = ['2s', '5s', '500ms'][seq % 3];
			seq += 1;
			if (!holder) {
				holder = { name, lease };
				token += 1;
				render(`${name} ACQUIRED at once — the lock was free.`);
			} else {
				queue.push({ name, lease });
				render(`${name} sent ACQUIRE → WAITING at position ${queue.length}. Waiters heartbeat too.`);
			}
		});
	}
</script>

